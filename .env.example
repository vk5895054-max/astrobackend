# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/astro
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS (production) ---
# Comma-separated list. In production these are the only browser origins
# allowed with credentials. CORS_ORIGINS is optional extra entries
# (e.g. the admin panel URL).
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://admin.example.com

# --- AI providers ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# gemini-2.5-flash was retired (404) — use a supported model.
GOOGLE_MODEL=gemini-3.5-flash
# Logo Studio uses Groq to create vector logo artwork and Cloudinary to store it.
# LOGO_GROQ_MODEL defaults to GROQ_MODEL; review uses Groq's Qwen vision model.
# LOGO_GROQ_MODEL=openai/gpt-oss-120b
# LOGO_VISION_MODEL=qwen/qwen3.8-27b
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- File uploads ---
# Vastu floor plans/photos/videos go to Cloudinary when all three values are
# set; otherwise they are stored locally under uploads/vastu/<userId>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Face & Palm Reading (optional) ---
# AI model overrides. Gemini handles inline images first; Groq/Qwen is the
# fallback. Both default to the provider settings above.
# READING_GEMINI_MODEL=gemini-3.5-flash
# READING_VISION_MODEL=qwen/qwen3.8-27b
# Face & Palm readings are free — no quota or wallet charging is applied.

# --- Vastu (optional) ---
# Default rules are seeded idempotently at runtime when the rule collection is
# empty. Run `npm run seed-vastu-rules` to seed/refresh them manually, or
# `npm run seed-vastu-rules -- --force` to reset the bundled defaults.
# VASTU_SEED_ON_START=true

# --- Voice (LiveKit) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Push notifications (Firebase Admin) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR
ALLOW_MOCK_RECHARGE=false
